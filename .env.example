# ===========================
# Environment Configuration
# ===========================
NODE_ENV="development"          # Options: 'development' or 'production'
PORT="8080"                     # The port your server will listen on
HOST="localhost"                # Server hostname

# ===========================
# CORS and Client URLs
# ===========================
CORS_ORIGIN="http://localhost:4173"
CORS_ORIGIN_PUBLIC="https://shortlinkz.online"
CLIENT_SHORT_LINK="http://localhost:4173/a"
SERVER_ALIAS_URL="http://localhost:8080/view"

# ===========================
# Rate Limiting
# ===========================
COMMON_RATE_LIMIT_WINDOW_MS="1000"
COMMON_RATE_LIMIT_MAX_REQUESTS="100"

# ===========================
# Database and Cache
# ===========================
DATABASE_URL="mongodb://localhost:27017/shorten-url"
REDIS_URL="redis://localhost:6379"

# ===========================
# JWT and Security Keys
# ===========================
PRIVATE_ACCESS_TOKEN_KEY="your_access_token_private_key_here"
PRIVATE_REFRESH_TOKEN_KEY="your_refresh_token_private_key_here"
ALGORITHM_JWT="HS256"
ACCESS_TOKEN_EXPIRATION_TIME="1h"
REFRESH_TOKEN_EXPIRATION_TIME="3d"
SECRET_OR_PUBLIC_JWT_KEY="your_jwt_secret_key_here"
PRIVATE_PASSWORD="your_strong_private_password_here"
PASSWORD_SECRET="your_password_secret_here"

# ===========================
# Email Configuration (SMTP)
# ===========================
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
CLIENT_URL="http://localhost:4173"
EMAIL_USER="your_email@example.com"
EMAIL_PASSWORD="your_email_app_password"

# ===========================
# Google OAuth2
# ===========================
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:4173/a"

# ===========================
# Google reCAPTCHA
# ===========================
SECRECT_KEY_RECAPCHA="your_google_recaptcha_secret_key"